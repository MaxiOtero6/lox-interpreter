fun assert(input, expected) {
    if (input != expected) {
        print "ERROR";
    } else {
        print "OK";
    }
}

print "--- ARRAYS ---";

var xs = [1, 2, 3];
assert(xs[0], 1);
assert(xs[1], 2);
assert(xs[2], 3);

xs[1] = xs[0] + xs[2];
assert(xs[1], 4);

var nested = [[1, 2], [3, 4]];
assert(nested[0][1], 2);
nested[1][0] = 99;
assert(nested[1][0], 99);

assert("hello"[1], "e");
